# Configuración de Entorno — IN SIDE LOGISTIC | Gestión de Cotizaciones
APP_TIMEZONE="America/Mexico_City"
SESSION_SECRET="isl-cotizaciones-secret-key-change-in-production-2026"

# Base de Datos Local (Por defecto usa data/isl_cotizaciones.sqlite)
SQLITE_DB_PATH="./data/isl_cotizaciones.sqlite"

# Supabase (PostgreSQL Cloud + Auth — Producción)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Integración Google Drive API (Entrega 2)
GOOGLE_DRIVE_CLIENT_EMAIL=""
GOOGLE_DRIVE_PRIVATE_KEY=""
GOOGLE_DRIVE_ROOT_FOLDER_ID=""

# Notificaciones por Correo Transaccional (Entrega 3)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="notificaciones@insidelogistic.com.mx"
